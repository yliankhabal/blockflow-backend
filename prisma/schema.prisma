datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Job {
  id        String    @id @default(uuid())
  status    JobStatus @default(QUEUED)
  progress  Int       @default(0)
  metadata  Json?
  result    Json?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("job")
}

enum JobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}
